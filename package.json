{
  "name": "currency-exchange-api",
  "version": "1.0.0",
  "description": "REST API for a digital currency exchange",
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "hono": "4.13.1",
    "jose": "6.2.8",
    "mongoose": "8.24.2",
    "zod": "4.4.3",
    "nodemailer": "9.0.5",
    "@node-rs/argon2": "2.0.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@biomejs/biome": "2.5.7",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1"
  }
}
