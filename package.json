{
  "name": "currency-exchange-api",
  "version": "1.0.0",
  "description": "REST API for a digital currency exchange",
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "mongoose": "^8.9.2",
    "zod": "^3.24.1",
    "nodemailer": "^6.9.16",
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17"
  }
}
