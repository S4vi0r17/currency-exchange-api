# --- Server ---
NODE_ENV=development
PORT=3000

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/currency_exchange

# --- External rate provider (SECURITY: solo lectura, no requiere credenciales) ---
EXTERNAL_RATES_URL=https://api.test.cambioseguro.com/api/v1.1/config/rates

# --- JWT (EdDSA / Ed25519 via jose) ---
# NOTE: correr `bun run scripts/generate-jwt-keys.ts` una vez y pegar acá las dos líneas que imprime (formato JWK/JSON)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRES_IN=1h

# --- Email: adapter SMTP (Mailhog en dev/docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Currency Exchange <no-reply@currency-exchange.local>"

# --- Email: adapter Resend (opcional, si se define esta key se usa Resend en vez de SMTP) ---
RESEND_API_KEY=

# --- Admin seed (para poder crear el primer usuario admin sin endpoint público de "hazte admin") ---
ADMIN_SEED_EMAIL=admin@currency-exchange.local
ADMIN_SEED_PASSWORD=change-me-please
